# Copy to .env and fill in. Never commit .env.

# --- Database (docker-compose Postgres) ---
POSTGRES_USER=trimatch
POSTGRES_PASSWORD=trimatch
POSTGRES_DB=trimatch
DATABASE_URL=postgresql+psycopg://trimatch:trimatch@127.0.0.1:5432/trimatch

# --- LLM: local only, no API keys needed anywhere ---
# ollama = a local Ollama server on this machine; replay = recorded responses (tests/CI)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Refuses any non-local host unless this is true (invoice data would leave the machine).
ALLOW_REMOTE_LLM=false
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- Extraction ---
MIN_TEXT_CHARS=80
MAX_VISION_PAGES=3

# --- Agent ---
AGENT_MAX_TOOL_CALLS=8

# --- Policy ---
AUTO_APPROVE_LIMIT=50000
MIN_CONFIDENCE=0.9

# --- Matching tolerances ---
PRICE_TOLERANCE_PCT=1
ARITHMETIC_TOLERANCE=1
DUPLICATE_WINDOW_DAYS=30

# --- Display ---
# USD to INR rate, used only to show the average model cost in rupees on the Metrics page.
# Leave blank if unsure; a local model costs nothing, which needs no rate.
USD_TO_INR=

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Langfuse (local, from docker-compose; create keys in the Langfuse UI at :3000) ---
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_NEXTAUTH_SECRET=change-me-local-only
LANGFUSE_SALT=change-me-local-only
